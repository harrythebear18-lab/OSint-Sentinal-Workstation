{
  "name": "osint-sentinel-workstation",
  "version": "0.1.0",
  "description": "Offline-first multispectral geospatial intelligence workstation — Sentinel-2 base, live satellite overlays, SAR/AI analysis.",
  "main": "out/main/index.js",
  "private": true,
  "author": "",
  "license": "SEE LICENSING.md (VOC-L for Cockpit, VCE-L for Core Engine, VPL for Plugins)",
  "scripts": {
    "copy:cesium": "node -e \"require('fs').cpSync('node_modules/cesium/Build/Cesium', 'public/cesium', { recursive: true, force: true })\"",
    "compile:wasm": "node scripts/compile-wasm.mjs",
    "obfuscate": "node scripts/obfuscate-build.mjs",
    "dev": "npm run copy:cesium && node scripts/dev.js",
    "build": "npm run compile:wasm && npm run copy:cesium && npx electron-vite build",
    "build:prod": "set NODE_ENV=production && npm run build && npm run obfuscate",
    "preview": "node scripts/preview.js",
    "dist:win": "npm run build:prod && npx electron-builder --win",
    "dist:mac": "npm run build:prod && npx electron-builder --mac",
    "dist:portable": "npm run build:prod && npx electron-builder --win portable",
    "dist:all": "npm run build:prod && npx electron-builder --win --mac"
  },
  "build": {
    "appId": "com.osint-sentinel-workstation.app",
    "productName": "OSINT Sentinel Workstation",
    "directories": {
      "output": "E:/osint-builds/release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!**/*.map",
      "!**/*.d.ts.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "overrides": {
    "geotiff": {
      "quick-lru": "5.1.1"
    }
  },
  "dependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@types/adm-zip": "^0.5.8",
    "@xmldom/xmldom": "^0.9.12",
    "adm-zip": "^0.6.0",
    "cesium": "^1.124.0",
    "geotiff": "^3.0.5",
    "mp4box": "^2.4.1",
    "pngjs": "^7.0.0",
    "proj4": "^2.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satellite.js": "^6.0.2",
    "terser": "^5.51.2",
    "webm-muxer": "^5.1.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@webgpu/types": "^0.1.72",
    "electron": "^32.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "javascript-obfuscator": "^5.7.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wabt": "^1.0.39"
  }
}
